{
  "manifest_version": 3,
  "name": "Quran Continue",
  "version": "0.1.0",
  "description": "Opens quran.com as a pinned tab at the verse where you last stopped, and keeps your place in sync through your Quran.com account.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "scripting", "idle", "alarms", "identity"],
  "host_permissions": [
    "https://quran.com/*",
    "https://prelive-oauth2.quran.foundation/*",
    "https://oauth2.quran.foundation/*",
    "https://apis-prelive.quran.foundation/*",
    "https://apis.quran.foundation/*"
  ],
  "web_accessible_resources": [
    { "resources": ["icons/icon32.png"], "matches": ["https://quran.com/*"] }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://quran.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "action": {
    "default_title": "Quran Continue",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" },
    "default_popup": "popup.html"
  },
  "commands": {
    "open-quran": {
      "suggested_key": { "default": "Alt+Shift+Q" },
      "description": "Open the Quran at your last verse"
    }
  }
}
